# Security
SECRET_KEY=
ALLOWED_HOSTS=

# Debug
DEBUG=False

# DataBase
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Twitch API (data-fetch worker; separate from user-login OAuth)
TWITCH_API_CLIENT_SECRET=
TWITCH_API_CLIENT_ID=

# Twitch OAuth (user login via allauth; register a SECOND Twitch app for this)
TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=

# Frontend origin (used for post-login redirects and cookie domain logic)
FRONTEND_URL=http://localhost:3000

# Redis URL for the shared rate-limit cache. Leave BLANK in local dev (falls
# back to in-process memory). REQUIRED in production so request counts are
# shared across all gunicorn workers - e.g. redis://127.0.0.1:6379/1 for a
# Redis running on the same VPS.
REDIS_URL=

# Number of proxies between the public internet and Django, used to read the
# real client IP for per-IP rate limiting. Next.js alone in front of Django = 1.
# Add 1 for each additional reverse proxy (nginx/Caddy/Cloudflare).
# To verify: hit the API from a known external IP and temporarily log
# request.META["HTTP_X_FORWARDED_FOR"]; NUM_PROXIES should make DRF resolve to
# that IP (too low = everyone shares the proxy's bucket; too high = clients can
# forge the header).
NUM_PROXIES=1

# Cloudflare Turnstile secret key (contact-form spam protection). Leave blank
# in dev to skip verification. The matching site key goes in the frontend env
# as TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=