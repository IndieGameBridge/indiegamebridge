# Security
SECRET_KEY=
ALLOWED_HOSTS=

# Debug
DEBUG=False

# DataBase
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Twitch API (data-fetch worker; separate from user-login OAuth)
TWITCH_API_CLIENT_SECRET=
TWITCH_API_CLIENT_ID=

# Twitch OAuth (user login via allauth; register a SECOND Twitch app for this)
TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=

# Frontend origin (used for post-login redirects and cookie domain logic)
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile secret key (contact-form spam protection). Leave blank
# in dev to skip verification. The matching site key goes in the frontend env
# as TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=