# Production build-time config. Loaded by `next build` (production), NOT by
# `next dev`. Needed because next.config.ts builds the proxy rewrite targets
# from process.env.API_BASE_URL at BUILD time — runtime wrangler.jsonc vars are
# too late for that. Keep these in sync with the `vars` in wrangler.jsonc.
#
# Non-secret (public origins), so committed for reproducible builds.

API_BASE_URL=https://api.indiegamebridge.com
FRONTEND_URL=https://indiegamebridge.com
TURNSTILE_SITE_KEY=0x4AAAAAADfBuePE49vHwC0s
