# Local development config. Copy this to `.env.development` (NOT `.env`).
#
# `.env` is loaded in ALL environments, including the production `next build`
# that OpenNext runs for Cloudflare — its localhost values would get bundled
# into the Worker and override the wrangler.jsonc vars. `.env.development` is
# only loaded by `next dev`, so production picks up the real prod URLs from
# wrangler.jsonc instead.

# Django backend origin (server-side fetches and middleware.ts target)
API_BASE_URL=http://localhost:8000

# Frontend origin (Origin header for the refresh-token call in middleware.ts;
# must match CSRF_TRUSTED_ORIGINS on the Django side)
FRONTEND_URL=http://localhost:3000

# Cloudflare Turnstile site key (public) for the contact form. Leave blank in
# dev to skip the widget; the backend (TURNSTILE_SECRET_KEY) skips verification
# to match. Read server-side and passed to the form, so no NEXT_PUBLIC_ prefix.
TURNSTILE_SITE_KEY=
